# =====================================================================
# Community Discord Web — env vars
# Copy to .env.local for dev; set the same keys in Vercel for prod.
# NEVER commit .env.local — it's git-ignored.
# =====================================================================

# --- Discord (from https://discord.com/developers/applications) ---
DISCORD_CLIENT_ID=your-application-client-id
DISCORD_CLIENT_SECRET=your-oauth-client-secret
DISCORD_BOT_TOKEN=your-bot-token
DISCORD_GUILD_ID=your-test-server-id
DISCORD_LINKED_ROLE_ID=1549269893600383026

# --- Supabase (from Project Settings > API) ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- OAuth callback URL — must EXACTLY match Discord Developer Portal ---
# Local dev: http://localhost:3000/api/oauth/callback
# Vercel prod: https://your-app.vercel.app/api/oauth/callback
OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/callback

# --- State-signing secret — generate with: openssl rand -hex 32 ---
STATE_SECRET=your-random-hex-string

# --- Session cookie signing secret — same generation ---
SESSION_SECRET=another-random-hex-string
